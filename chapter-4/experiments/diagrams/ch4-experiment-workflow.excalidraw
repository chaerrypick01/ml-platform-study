    {
      "id": "fa-note",
      "type": "text",
      "x": 65.62070943643653,
      "y": 2042.2963714325488,
      "width": 1124.23193359375,
      "height": 41.4,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": [],
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 18,
      "frameId": null,
      "groupIds": [
        "uTSucY8rtt-iaQW_5xhAp"
      ],
      "index": "b0B",
      "isDeleted": false,
      "lineHeight": 1.15,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "online ≠ real-time: online은 'predict 순간에 key 하나로 빠르게 조회'라는 뜻. 값을 real-time으로 갱신하려면 Stream·Push 또는 주기적 materialize가 필요\n같은 feature 정의를 training·serving이 함께 써서 training-serving skew를 줄임  /  지금 학습 CSV에는 user_id가 없어 연결하려면 ID mapping이 필요",
      "roughness": 1,
      "roundness": null,
      "seed": 861475275,
      "strokeColor": "#475569",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "online ≠ real-time: online은 'predict 순간에 key 하나로 빠르게 조회'라는 뜻. 값을 real-time으로 갱신하려면 Stream·Push 또는 주기적 materialize가 필요\n같은 feature 정의를 training·serving이 함께 써서 training-serving skew를 줄임  /  지금 학습 CSV에는 user_id가 없어 연결하려면 ID mapping이 필요",
      "textAlign": "left",
      "updated": 1793520670647,
      "version": 1,
      "versionNonce": 843909109,
      "verticalAlign": "top"
    },
